; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is generated by Godot for reference.

config_version=5

[application]

config/name="Sbrebols e il Tesoro della Ciurma"
config/description="Un giovane pirata raccoglie le 10 chiavi per aprire il Tesoro della Ciurma."
run/main_scene="res://scenes/core/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/images/ui/icon.png"

[autoload]

GameManager="*res://scripts/core/GameManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
SceneTransition="*res://scripts/core/SceneTransition.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

; Touch input mappings handled in code via InputEventScreenTouch

[rendering]

renderer/rendering_method="mobile"
